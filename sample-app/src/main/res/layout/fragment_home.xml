<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/home_screen_padding_horizontal"
        android:paddingRight="@dimen/home_screen_padding_horizontal"
        android:paddingTop="@dimen/home_screen_padding_top"
        android:paddingBottom="@dimen/home_screen_padding_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectPresetBtn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_select_preset_height"
            android:layout_marginBottom="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/home_select_preset"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="@dimen/home_select_preset_text_size"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="@dimen/home_select_preset_corner_radius"
            app:elevation="0dp"
            app:icon="@drawable/ic_home_preset_icon"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/home_select_preset_icon_padding"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:rippleColor="?attr/colorControlHighlight" />

        <LinearLayout
            android:id="@+id/idFieldsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSpotId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:hint="@string/home_spot_id"
                app:boxCornerRadiusBottomEnd="4dp"
                app:boxCornerRadiusBottomStart="4dp"
                app:boxCornerRadiusTopEnd="4dp"
                app:boxCornerRadiusTopStart="4dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSpotId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="sp_eCIIROSD" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPostId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/home_post_id"
                app:boxCornerRadiusBottomEnd="4dp"
                app:boxCornerRadiusBottomStart="4dp"
                app:boxCornerRadiusTopEnd="4dp"
                app:boxCornerRadiusTopStart="4dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPostid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="sdk1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMenuButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/btnUIComponents"
                layout="@layout/item_home_menu_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_menu_row_spacing" />

            <include
                android:id="@+id/btnUIFlows"
                layout="@layout/item_home_menu_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_menu_row_spacing" />

            <include
                android:id="@+id/btnUIViews"
                layout="@layout/item_home_menu_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_menu_row_spacing" />

            <include
                android:id="@+id/btnMiscellaneous"
                layout="@layout/item_home_menu_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_menu_row_spacing" />

            <include
                android:id="@+id/btnVerticalDemo"
                layout="@layout/item_home_menu_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_menu_row_spacing" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_metadata_margin_top"
            android:background="@drawable/home_card_background"
            android:orientation="vertical"
            android:padding="@dimen/home_metadata_padding">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMetadataTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/home_metadata_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/home_metadata_title_size" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/home_metadata_text_size"
                tools:text="Date: 01/01/2025" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvVersionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/home_metadata_text_size"
                tools:text="Version: 1.0.0 (1)" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/home_metadata_text_size"
                tools:text="release/app/2.0.0.0" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBuildVariant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/home_metadata_text_size"
                tools:text="Flavor: PublicSDK" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEnvironmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:textSize="@dimen/home_metadata_text_size"
                tools:text="Environment: Staging" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
