<?xml version="1.0" encoding="utf-8"?>
<!-- Half-circle badge: left half = light mode, right half = dark mode -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">

    <!-- Light left half: counterclockwise arc from top (10,1) to bottom (10,19) -->
    <path
        android:fillColor="#F0F0F0"
        android:pathData="M10,1 A9,9 0 0,0 10,19 Z"/>

    <!-- Dark right half: clockwise arc from top (10,1) to bottom (10,19) -->
    <path
        android:fillColor="#333333"
        android:pathData="M10,1 A9,9 0 0,1 10,19 Z"/>

    <!-- Circle outline -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#888888"
        android:strokeWidth="1.2"
        android:pathData="M10,1 A9,9 0 0,1 10,19 A9,9 0 0,1 10,1"/>

</vector>
