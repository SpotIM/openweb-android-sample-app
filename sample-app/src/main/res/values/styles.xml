<resources>

    <style name="SettingsChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">#000</item>
        <item name="chipBackgroundColor">@color/bg_chip_state_list</item>
        <item name="rippleColor">@color/bg_chip_ripple_color</item>
    </style>

    <style name="SampleAppRadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">@drawable/radio_button_selector</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SampleAppButton" parent="spotim_core_t4_sb">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/button_background</item>
    </style>

    <!-- Empty base so dotted child names (`SampleApp.X`) resolve without an explicit parent. -->
    <style name="SampleApp" />

    <!-- Reusable Material 3-aligned styles for the home / UI Components surfaces -->
    <style name="SampleApp.HomeMenuRow">
        <item name="android:background">@drawable/home_card_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/home_menu_row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/home_menu_row_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/home_menu_row_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/home_menu_row_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/home_menu_row_padding_vertical</item>
    </style>

    <style name="SampleApp.HomeMenuRowTitle" parent="">
        <item name="android:textSize">@dimen/home_menu_title_size</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SampleApp.HomeMenuRowSubtitle" parent="">
        <item name="android:textSize">@dimen/home_menu_subtitle_size</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SampleApp.SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/home_section_label_margin_top</item>
        <item name="android:layout_marginBottom">@dimen/home_section_label_margin_bottom</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/home_section_label_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SampleApp.PillToggleCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/home_pill_height</item>
        <item name="cardBackgroundColor">@color/ui_components_nav_mode_toggle_bg</item>
        <item name="cardCornerRadius">@dimen/home_pill_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="SampleApp.PillToggleLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/home_pill_label_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Material 3-aligned toolbar styles for MainActivity. Tints menu icons + nav up arrow
         to home_on_surface so they remain visible against the surface-tone background. -->
    <style name="SampleApp.Toolbar" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="colorPrimary">@color/home_surface</item>
        <item name="colorOnPrimary">@color/home_on_surface</item>
        <item name="colorControlNormal">@color/home_on_surface</item>
        <item name="android:textColorPrimary">@color/home_on_surface</item>
        <item name="android:textColorSecondary">@color/home_on_surface</item>
    </style>

    <style name="SampleApp.Toolbar.TitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/home_on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <style name="SampleAppButtonGhost" parent="Widget.AppCompat.Button">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/defaultTextColor</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/button_ghost_background</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="ToolbarViewButton" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">#FF000000</item>
        <item name="android:textSize">26sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- Style with custom fontFamily, provided to OWSdk as a reference ID during initialization -->
    <style name="CustomFontStyle">
        <item name="android:fontFamily">@font/the_times_custom_font_family</item>
        <item name="fontFamily">@font/the_times_custom_font_family</item>
    </style>
    
    <!-- Theme for our test activity to demonstrate theme override issue -->
    <style name="PublisherCustomTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#FF5722</item>
        <item name="colorPrimaryDark">#E64A19</item>
        <item name="colorAccent">#4CAF50</item>
        <item name="android:textColor">#0000FF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:windowBackground">#FFEB3B</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_fitToContents">true</item>
        <item name="behavior_hideable">true</item>
    </style>

    <!-- Custom Preference Dialog Theme -->
    <style name="PreferenceDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        
        <!-- Dialog shape with rounded corners -->
        <item name="shapeAppearanceOverlay">@style/DialogShapeAppearance</item>
        
        <!-- Radio button style -->
        <item name="android:radioButtonStyle">@style/CustomRadioButton</item>
        
        <!-- Button styles -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
        
        <!-- Dialog sizing -->
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Rounded corners for dialog -->
    <style name="DialogShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Custom Radio Button -->
    <style name="CustomRadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:buttonTint">@color/colorAccent</item>
    </style>

    <!-- Positive button style (OK) -->
    <style name="DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Negative button style (CANCEL) -->
    <style name="DialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Preference Category Style -->
    <style name="PreferenceCategoryStyle" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_material</item>
    </style>

    <!-- Preference Category Title Style -->
    <style name="PreferenceCategoryTitle" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">start</item>
    </style>

</resources>
